{
    "tabWidth": 4,
    "trailingComma": "all",
    "printWidth": 180,
    "singleQuote": false,
    "jsxSingleQuote": false,
    "plugins": ["prettier-plugin-astro", "prettier-plugin-tailwindcss"],
    "overrides": [
        {
            "files": "*.astro",
            "options": {
                "parser": "astro"
            }
        }
    ],
    "tailwindStylesheet": "./src/css/global.css"
}
