---
import { Font } from "astro:assets";
import "../css/global.css";

interface Props {
    subtitle: string;
}
---

<html lang="en">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <meta name="generator" content={Astro.generator} />
        <title>Skye's Site - {Astro.props.subtitle}</title>
        <Font cssVariable="--font-m-plus-rounded-1c" preload={[{ weight: 500 }]} />
    </head>
    <body class="min-h-screen w-full overflow-hidden bg-neutral-300 font-m-plus-rounded-1c font-medium text-black dark:bg-olive-950 dark:text-white">
        <main id="main-content-scroll-container" class="h-screen overflow-auto">
            <slot />
        </main>
    </body>
</html>
