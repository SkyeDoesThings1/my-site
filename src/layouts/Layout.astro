---
import { Font } from "astro:assets";
import "../css/global.css";

interface Props {
    subtitle: string;
}
---

<html lang="en">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <link rel="icon" href="/favicon.svg" type="image/svg+xml" sizes="any" />
        <link rel="icon" href="/favicon.ico" type="image/x-icon" sizes="16x16 32x32 48x48 64x64" />
        <meta name="generator" content={Astro.generator} />
        <title>Skye's Site - {Astro.props.subtitle}</title>
        <Font cssVariable="--font-m-plus-rounded-1c" preload={[{ weight: 500 }]} />
    </head>
    <body class="min-h-screen w-full overflow-hidden bg-olive-950 font-m-plus-rounded-1c font-medium text-olive-50">
        <main id="main-content-scroll-container" class="h-screen overflow-auto">
            <slot />
        </main>
    </body>
</html>
