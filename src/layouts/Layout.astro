---
import { Font } from "astro:assets";
import "../css/global.css";

interface Props {
    subtitle: string;
}

const currentPath = Astro.url.pathname;
---

<html lang="en">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <link rel="icon" href="/favicon.svg" type="image/svg+xml" sizes="any" />
        <link rel="icon" href="/favicon.ico" type="image/x-icon" sizes="16x16 32x32 48x48 64x64" />
        <meta name="generator" content={Astro.generator} />
        <title>Skye's Site - {Astro.props.subtitle}</title>
        <Font cssVariable="--font-m-plus-rounded-1c" preload={[{ weight: 500 }]} />
    </head>
    <body class="min-h-screen w-full overflow-hidden bg-olive-950 font-m-plus-rounded-1c font-medium text-olive-200 lowercase">
        <div id="main-content-scroll-container" class="h-screen overflow-auto">
            <nav class="flex justify-end px-6 py-4">
                <ul class="flex gap-6">
                    <li>
                        <a
                            href="/"
                            aria-current={currentPath === "/" ? "page" : undefined}
                            class:list={["text-sm font-semibold tracking-wide transition-colors", currentPath === "/" ? "text-pink-300" : "text-olive-50 hover:text-olive-400"]}
                        >
                            Home
                        </a>
                    </li>

                    <li>
                        <a
                            href="/about/"
                            aria-current={currentPath === "/about/" ? "page" : undefined}
                            class:list={[
                                "text-sm font-semibold tracking-wide transition-colors",
                                currentPath === "/about/" ? "text-pink-300" : "text-olive-50 hover:text-olive-400",
                            ]}
                        >
                            About
                        </a>
                    </li>
                    <li>
                        <a
                            href="/music/"
                            aria-current={currentPath === "/music/" ? "page" : undefined}
                            class:list={[
                                "text-sm font-semibold tracking-wide transition-colors",
                                currentPath === "/music/" ? "text-pink-300" : "text-olive-50 hover:text-olive-400",
                            ]}
                        >
                            Music
                        </a>
                    </li>
                </ul>
            </nav>

            <main>
                <div class="flex min-h-full flex-col items-center justify-center px-6 py-24 sm:px-12">
                    <div class="w-full max-w-2xl">
                        <slot />
                    </div>
                </div>
            </main>
        </div>
    </body>
</html>
