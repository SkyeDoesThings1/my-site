---
import Layout from "../../../layouts/Layout.astro";
import { getRecentlyPlayed } from "../../../lib/spotify";
import { Icon } from "astro-icon/components";
import { Image } from "astro:assets";

export const prerender = false;

Astro.cache.set({
    maxAge: 60,
    swr: 60,
    tags: ["spotify-recently-played"],
});

const recentlyPlayed = await getRecentlyPlayed(20);
---

<Layout subtitle="Music - Spotify">
    <p class="mb-4 text-center text-sm font-semibold tracking-[0.2em] text-olive-400 uppercase">Recently played</p>

    <h1 class="text-center text-5xl font-semibold sm:text-6xl">Spotify</h1>

    <div class="mx-auto my-8 h-px w-16 bg-linear-to-r from-transparent via-pink-500 to-transparent"></div>

    <p class="mx-auto max-w-2xl text-center text-lg leading-relaxed text-olive-100/90 sm:text-xl">
        This page will show you the last ten songs I've listened to on Spotify! It doesn't update immediatly to avoid spamming their API lmao
    </p>

    <div class="mx-auto mt-12 max-w-5xl">
        <div
            class="mx-auto mt-12 mb-8 flex max-w-3xl flex-col items-center rounded-2xl border border-pink-300 bg-olive-900/60 p-6 shadow-lg shadow-black/30 backdrop-blur-sm sm:p-8"
        >
            <p class="mb-6 text-center text-xs font-semibold tracking-[0.2em] text-olive-400 uppercase">Back</p>

            <div class="flex flex-wrap justify-center gap-3">
                <a
                    href="/music/"
                    class="group inline-flex items-center gap-2 rounded-xl border border-pink-300/50 px-4 py-2.5 text-sm font-semibold tracking-wide text-pink-300 transition-all duration-300 hover:-translate-y-0.5 hover:gap-3 hover:border-pink-300 hover:bg-pink-300 hover:text-olive-950"
                >
                    Back to Music
                    <Icon name="untitled-ui/arrow-right" />
                </a>
            </div>
        </div>
        {
            (
                <ul class="grid grid-cols-2 gap-6 sm:grid-cols-3 lg:grid-cols-4">
                    {recentlyPlayed.items.map((item) => {
                        const images = item.track.album.images;

                        const largeImage = images[0]?.url ?? "/favicon.svg";

                        return (
                            <li class="group min-w-0">
                                <a
                                    href={item.track.external_urls.spotify}
                                    target="_blank"
                                    rel="noopener noreferrer"
                                    class="block rounded-2xl p-2 transition-colors duration-300 hover:bg-pink-300/10 focus-visible:ring-2 focus-visible:ring-pink-300 focus-visible:outline-none"
                                >
                                    <div class="overflow-hidden rounded-xl shadow-lg shadow-black/30">
                                        <Image
                                            src={largeImage}
                                            widths={[240, 480, 640]}
                                            sizes="(max-width: 640px) 44vw, (max-width: 1024px) 29vw, 23vw"
                                            alt={`Album artwork for ${item.track.name}`}
                                            width={640}
                                            height={640}
                                            loading="lazy"
                                            class="aspect-square w-full object-cover transition-transform duration-500 ease-out group-hover:scale-105"
                                        />
                                    </div>

                                    <div class="mt-3 min-w-0 px-1">
                                        <h2 class="line-clamp-2 text-base leading-snug font-semibold text-olive-50">{item.track.name}</h2>

                                        <p class="mt-1 truncate text-sm text-olive-200/70">{item.track.artists.map((artist) => artist.name).join(", ")}</p>
                                    </div>
                                </a>
                            </li>
                        );
                    })}
                </ul>
            )
        }
    </div>
</Layout>
