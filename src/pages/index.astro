---
import Layout from "../layouts/Layout.astro";
import { Icon } from "astro-icon/components";
---

<Layout subtitle="Home">
    <p class="mb-4 text-center text-sm font-semibold tracking-[0.2em] text-olive-400 uppercase">Welcome</p>

    <h1 class="text-center text-5xl font-semibold sm:text-6xl">Hey, I'm Skye!</h1>

    <div class="mx-auto my-8 h-px w-16 bg-linear-to-r from-transparent via-pink-500 to-transparent"></div>

    <p class="mx-auto max-w-2xl text-center text-lg leading-relaxed text-olive-100/90 sm:text-xl">
        Hello, and welcome to my website! This is my personal space where I'll share all sorts of things, from my favorite music and media, to stories and blogs about my life. This
        space is everything about me, thrown into a website.
    </p>

    <div class="mx-auto mt-12 flex max-w-3xl flex-col items-center rounded-2xl border border-pink-300 bg-olive-900/60 p-6 shadow-lg shadow-black/30 backdrop-blur-sm sm:p-8">
        <p class="mb-6 text-center text-xs font-semibold tracking-[0.2em] text-olive-400 uppercase">Sitemap</p>

        <div class="flex flex-wrap justify-center gap-3">
            <a
                href="/about/"
                class="group inline-flex items-center gap-2 rounded-xl border border-pink-300/50 px-4 py-2.5 text-sm font-semibold tracking-wide text-pink-300 transition-all duration-300 hover:-translate-y-0.5 hover:gap-3 hover:border-pink-300 hover:bg-pink-300 hover:text-olive-950"
            >
                About Me
                <Icon name="untitled-ui/arrow-right" />
            </a>

            <a
                href="/blog/"
                class="group inline-flex items-center gap-2 rounded-xl border border-pink-300/50 px-4 py-2.5 text-sm font-semibold tracking-wide text-pink-300 transition-all duration-300 hover:-translate-y-0.5 hover:gap-3 hover:border-pink-300 hover:bg-pink-300 hover:text-olive-950"
            >
                Read my blog
                <Icon name="untitled-ui/arrow-right" />
            </a>

            <a
                href="/music/"
                class="group inline-flex items-center gap-2 rounded-xl border border-pink-300/50 px-4 py-2.5 text-sm font-semibold tracking-wide text-pink-300 transition-all duration-300 hover:-translate-y-0.5 hover:gap-3 hover:border-pink-300 hover:bg-pink-300 hover:text-olive-950"
            >
                Music
                <Icon name="untitled-ui/arrow-right" />
            </a>
        </div>
    </div>
</Layout>
