---
import Layout from "../layouts/Layout.astro";
---

<Layout subtitle="Home">
    <p class="mb-4 text-center text-sm font-semibold tracking-[0.2em] text-olive-400 uppercase">Welcome</p>

    <h1 class="text-center text-5xl font-semibold sm:text-6xl">Hey, I'm Skye!</h1>

    <div class="mx-auto my-8 h-px w-16 bg-olive-700"></div>

    <p class="text-center text-lg leading-relaxed sm:text-xl">
        Hello, and welcome to my website! This is my personal space where I'll share all sorts of things, from my favorite music and media, to stories and blogs about my life. This
        space is everything about me, thrown into a website.
    </p>

    <div class="mt-12 flex flex-wrap justify-center gap-3 rounded-2xl border border-olive-800 bg-olive-900/60 p-6 shadow-lg shadow-black/20 backdrop-blur-sm sm:p-8">
        <a
            href="/about/"
            class="group inline-flex items-center gap-2 border border-pink-300/50 px-4 py-2.5 text-sm font-semibold tracking-wide text-pink-300 transition-all duration-200 hover:gap-3 hover:border-pink-300 hover:bg-pink-300 hover:text-olive-950"
        >
            About Me
            <svg class="h-4 w-4 transition-transform duration-200 group-hover:translate-x-1" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M4 12H20M20 12L14 6M20 12L14 18" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path>
            </svg>
        </a>

        <a
            href="/blog/"
            class="group inline-flex items-center gap-2 border border-pink-300/50 px-4 py-2.5 text-sm font-semibold tracking-wide text-pink-300 transition-all duration-200 hover:gap-3 hover:border-pink-300 hover:bg-pink-300 hover:text-olive-950"
        >
            Read my blog
            <svg class="h-4 w-4 transition-transform duration-200 group-hover:translate-x-1" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M4 12H20M20 12L14 6M20 12L14 18" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path>
            </svg>
        </a>

        <a
            href="/music/"
            class="group inline-flex items-center gap-2 border border-pink-300/50 px-4 py-2.5 text-sm font-semibold tracking-wide text-pink-300 transition-all duration-200 hover:gap-3 hover:border-pink-300 hover:bg-pink-300 hover:text-olive-950"
        >
            Music
            <svg class="h-4 w-4 transition-transform duration-200 group-hover:translate-x-1" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M4 12H20M20 12L14 6M20 12L14 18" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path>
            </svg>
        </a>
    </div>
</Layout>
